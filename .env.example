# Server Port Configuration
PORT=3000

# PostgreSQL Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://user:password@localhost:5432/project_epoch

# Frontend API Base URL (leave empty to use the Vite dev proxy)
VITE_API_BASE_URL=

# Admin back-office password (gates all write/delete/upload endpoints)
ADMIN_PASSWORD=change-me-before-deploying
